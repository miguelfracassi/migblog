{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/whatsapp", "destination": "https://wa.me/5519999894031", "permanent": false },
    { "source": "/instagram", "destination": "https://instagram.com/migfracassi", "permanent": false },
    { "source": "/ticord", "destination": "https://ticord.website", "permanent": false }
  ],
